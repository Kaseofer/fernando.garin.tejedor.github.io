---
const photo = `${import.meta.env.BASE_URL}/images/fernando-garin-hero-wide.png`;
const source = [
  "var ingeniero = new FernandoGarinTejedor",
  "{",
  "    Base = \"Buenos Aires, Argentina\",",
  "    Idiomas = [\"Español\", \"Inglés\"],",
  "    Modalidad = Trabajo.Remoto",
  "};",
  "",
  "// Lo que hago hoy",
  "var plataforma = Microservicios.Crear()",
  "    .ConApiRest()",
  "    .ConEventos()",
  "    .ConMensajeria(Kafka)",
  "    .ConContenedores(Docker);",
  "",
  "var repositorio = RepositoryFactory.Crear<Orden>();",
  "var cola = MessageQueue.Conectar(RabbitMq);",
  "await ProcesarAsync(async evento =>",
  "{",
  "    await repositorio.GuardarAsync(evento);",
  "    await cola.PublicarAsync(evento);",
  "});",
  "",
  "// 2026 — actualidad · Urbetrack",
  "ingeniero.Desarrollar(",
  "    stack: [.NET, CSharp, Kafka, SqlServer, Docker, AwsS3],",
  '    dominio: "telemetría, GPS e IoT");',
  "",
  "// 2011 — 2026 · Inspección General de Justicia",
  "ingeniero.Modernizar(",
  "    desde: [OracleForms, DotNetFramework],",
  "    hacia: [AspNetCore, Angular, RestApi],",
  '    basesDeDatos: [SqlServer, Oracle, PostgreSql]);',
  "",
  "// 2005 — 2011 · GLD Consultores",
  "ingeniero.Construir(",
  "    sistemas: [\"Torneos AAT\", \"PNRT\", \"Planes Sociales\"],",
  '    stack: [.NET, CSharp, SqlServer]);',
  "",
  "// 2003 — 2004 · Correo Argentino",
  "ingeniero.RastrearEnvios(",
  '    stack: [Java, VisualBasic6, SqlServer]);',
  "",
  "// 1998 — 2002 · Universidad Nacional de La Matanza",
  "ingeniero.Graduarse(\"Ingeniero en Informática\");",
  "",
  "// Actualización técnica",
  "ingeniero.Actualizarse(2021, \"Microservicios, Docker y Kafka\");",
  "ingeniero.Proyectos.Add(new Tero(MultiTenant));",
  "ingeniero.Proyectos.Add(new ConsultorioOne(Net10));",
  "",
  "Console.WriteLine(ingeniero.Disponible);"
];
const typos = [
  {
    "find": "Desarrollar",
    "offset": 3,
    "wrong": "rt"
  },
  {
    "find": "Modernizar",
    "offset": 5,
    "wrong": "nr"
  },
  {
    "find": "Graduarse",
    "offset": 4,
    "wrong": "mw"
  }
];
const terminal = [
  {
    "html": "<span style=\"color:var(--violet-text)\">$</span> dotnet run"
  },
  {
    "html": "✔ Build succeeded · 0 warnings · 0 errors",
    "cls": "ok"
  },
  {
    "html": "<span style=\"color:var(--kw)\">info:</span> 20+ años · .NET 2.0 → 10 · 2 proyectos propios",
    "cls": "muted"
  },
  {
    "html": "True"
  },
  {
    "html": "<span class=\"user\">fernando@portfolio</span>:<span style=\"color:var(--kw)\">~</span>$ <span class=\"cursor\"></span>"
  }
];
---
<section id="inicio" class="container hero-preview">
  <div class="copy">
    <img class="hero-photo" src={photo} alt="Fernando Garín Tejedor trabajando frente a sus notebooks" width="1672" height="940" fetchpriority="high" />
    <p class="status mono"><span class="dot"></span>Disponible para nuevos desafíos · Remoto desde Buenos Aires</p>
    <h1>Backend .NET para sistemas distribuidos que escalan.</h1>
    <p class="sub">Ingeniero en Informática con más de 20 años desarrollando software. Hoy trabajo con microservicios .NET, APIs y procesamiento de eventos en tiempo real.</p>
    <div class="ctas"><a href="#proyectos" class="btn btn-primary">Ver proyectos →</a><a href="#contacto" class="btn btn-ghost">Hablemos</a></div>
  </div>
  <div role="group" aria-label="Animación de Program.cs: habilidades actuales, experiencia y formación. La trayectoria completa está en la sección Experiencia." class="window" data-code-story data-source={JSON.stringify(source)} data-typos={JSON.stringify(typos)} data-terminal={JSON.stringify(terminal)}>
    <div class="bar mono"><span class="d" style="background:#ff5f57"></span><span class="d" style="background:#febc2e"></span><span class="d" style="background:#28c840"></span><span class="tab">Program.cs</span><span class="grow"></span><button type="button" class="cs-skip">Saltar ⏭</button><button type="button" class="cs-replay" hidden>↻ Repetir</button></div>
    <div class="scroller mono" aria-hidden="true"><div class="cs-gutter"></div><div class="cs-code"></div></div>
    <div class="cs-term mono" aria-hidden="true"></div>
  </div>
</section>
<style>
@import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Schibsted+Grotesk:wght@400;500;600;700;800&display=swap");
/* Tokens y utilidades compartidas del portfolio */
.hero-preview {
  --bg: #07111f;
  --surface: #0b1829;
  --surface-2: #0f2139;
  --line: #16273f;
  --line-2: #1c3150;
  --text: #e6edf6;
  --text-strong: #f4f7fb;
  --muted: #9fb0c6;
  --subtle: #6f86a3;

  --violet: #512bd4;         /* .NET */
  --violet-text: #a594f0;    /* violeta legible sobre fondo oscuro */
  --violet-bg: #0d1030;
  --violet-line: #2b2466;

  /* Sintaxis C# (VS Dark+) */
  --kw: #569cd6;
  --ident: #9cdcfe;
  --type: #4ec9b0;
  --method: #dcdcaa;
  --ctrl: #c586c0;
  --str: #ce9178;
  --comment: #6a9955;
  --punc: #c8d3e0;

  --font-sans: "Schibsted Grotesk", system-ui, sans-serif;
  --font-mono: "Arial Narrow", Arial, sans-serif;

  --gutter: clamp(16px, 5.5vw, 80px);
  --radius: 14px;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-sans);
  -webkit-font-smoothing: antialiased;
}
a { color: var(--violet-text); text-decoration: none; }
a:hover { color: #c7bdf7; }
:focus-visible { outline: 2px solid var(--violet-text); outline-offset: 3px; border-radius: 6px; }

.container { width: 100%; max-width: 1440px; margin: 0 auto; padding-inline: var(--gutter); }
.section { padding-block: clamp(64px, 9vw, 120px) 0; scroll-margin-top: 80px; }

.eyebrow { font-family: var(--font-mono); font-size: 14px; color: var(--violet-text); margin: 0 0 12px; }
.h2 {
  margin: 0; font-size: clamp(30px, 3.4vw, 44px); font-weight: 800;
  letter-spacing: -0.02em; line-height: 1.1; color: var(--text-strong);
}
.lead { margin: 0; font-size: 16px; line-height: 1.6; color: var(--muted); }
.mono { font-family: var(--font-mono); }

.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
  min-height: 52px; padding: 0 24px; border-radius: 10px;
  font-size: 16px; font-weight: 600; transition: background .2s, border-color .2s;
}
.btn-primary { background: var(--violet); color: #fff; }
.btn-primary:hover { background: #6340e0; color: #fff; }
.btn-ghost { border: 1px solid #2a3f5f; color: var(--text); }
.btn-ghost:hover { border-color: var(--violet-text); color: var(--text); }

.chip {
  display: inline-block; padding: 5px 10px; border-radius: 6px;
  font-family: var(--font-mono); font-size: 13px;
}

.card { border: 1px solid var(--line-2); border-radius: var(--radius); background: var(--surface); }

:global(.cursor) {
  display: inline-block; width: .55em; height: 1.05em; background: var(--violet-text);
  vertical-align: -0.15em; animation: blink 1s steps(1) infinite;
}
@keyframes blink { 50% { opacity: 0; } }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  :global(.cursor) { animation: none; }
}


  .hero-preview {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px; align-items: start;
    padding-top: clamp(48px, 7vw, 96px); padding-bottom: clamp(48px, 6vw, 80px);
  }
  .copy {
    position: relative; isolation: isolate; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 18px;
    min-height: 638px; padding: 300px 28px 28px;
    border-radius: 14px; background: #07111f;
  }
  .hero-photo {
    position: absolute; inset: 0 0 auto; z-index: -2;
    width: 100%; height: 440px; object-fit: cover; object-position: 68% 28%;
  }
  .copy::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(180deg, rgba(7,17,31,.28), rgba(7,17,31,.02) 25%, rgba(7,17,31,.85) 49%, #07111f 68%);
  }
  .status { position: absolute; top: 20px; left: 24px; right: 24px; display: flex; align-items: center; gap: 10px; margin: 0; font-size: 11px; color: #b8f1df; text-shadow: 0 1px 5px #000; }
  .status .dot { flex-shrink: 0; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--type); box-shadow: 0 0 0 4px rgba(78,201,176,.15); }
  h1 {
    margin: 0; font-size: clamp(32px, 3vw, 44px); line-height: 1.08; font-weight: 800;
    letter-spacing: -0.02em; color: var(--text-strong);
  }
  .sub { margin: 0; font-size: 16px; line-height: 1.6; color: #bdcadd; max-width: 560px; }
  .ctas { display: flex; gap: 14px; flex-wrap: wrap; }


  @media (max-width: 1100px) {
    .hero-preview { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .hero-photo { object-position: 65% 30%; }
    .copy { min-height: 620px; }
  }
  @media (max-width: 600px) {
    .copy { padding: 300px 20px 24px; }
    .status { left: 20px; right: 20px; }
    .ctas .btn { flex: 1 1 100%; }
  }


  .window {
    border-radius: 14px; overflow: hidden; border: 1px solid #22314a; background: #1e1e1e;
    box-shadow: 0 30px 80px rgba(0,0,0,.5), 0 0 0 1px rgba(81,43,212,.2);
  }
  .bar { height: 40px; display: flex; align-items: center; gap: 8px; padding: 0 8px 0 16px; background: #2d2d30; font-size: 13px; }
  .d { width: 12px; height: 12px; border-radius: 50%; }
  .tab { margin-left: 14px; color: #fff; border-bottom: 2px solid var(--violet-text); padding-bottom: 2px; }
  .grow { flex: 1; }
  .bar button {
    min-height: 32px; padding: 0 12px; border-radius: 6px; border: 1px solid #3c3c3c;
    background: transparent; color: #c8c8c8; font: inherit; font-size: 12px; cursor: pointer;
  }
  .bar button:hover { border-color: var(--violet-text); color: #fff; }

  .scroller {
    height: 420px; overflow: hidden; display: grid; grid-template-columns: auto minmax(0, 1fr);
    gap: 18px; padding: 18px 20px 18px 0; font-size: clamp(12px, 1.05vw, 15px); line-height: 1.75;
    scroll-behavior: smooth;
  }
  .cs-gutter { text-align: right; color: #5a5a5a; min-width: 44px; user-select: none; }
  .cs-code { color: #d4d4d4; white-space: pre; }

  .cs-term { border-top: 1px solid #333; background: #161616; padding: 16px 24px 20px; font-size: clamp(12px, 1vw, 14px); line-height: 1.9; color: #c8c8c8; min-height: 176px; }
  .cs-term :global(.cs-tl) { opacity: 0; animation: show .35s ease forwards; }
  .cs-term :global(.ok) { color: var(--type); }
  .cs-term :global(.muted) { color: var(--muted); }
  .cs-term :global(.user) { color: var(--violet-text); font-weight: 700; }
  @keyframes show { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

  /* Colores de sintaxis C# */
  .cs-code :global(.tk-kw) { color: var(--kw); }
  .cs-code :global(.tk-ctrl) { color: var(--ctrl); }
  .cs-code :global(.tk-t) { color: var(--type); }
  .cs-code :global(.tk-m) { color: var(--method); }
  .cs-code :global(.tk-i) { color: var(--ident); }
  .cs-code :global(.tk-s) { color: var(--str); }
  .cs-code :global(.tk-n) { color: #b5cea8; }
  .cs-code :global(.tk-c) { color: var(--comment); }
  .cs-code :global(.cs-caret) {
    display: inline-block; width: 2px; height: 1.2em; margin-left: 1px; background: #aeafad;
    vertical-align: -0.25em; animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (max-width: 600px) {
    .scroller { height: 360px; gap: 10px; padding-right: 12px; font-size: 10px; overflow-x: auto; }
    .cs-gutter { min-width: 28px; }
    .cs-term { padding-inline: 14px; }
  }

.hero-preview { padding-top: 150px; font-family: var(--font-sans); scroll-margin-top: 96px; }
.copy, .window { min-width: 0; }
.scroller { overflow: auto; scroll-behavior: auto; }
.btn { text-decoration: none; }
.bar button[hidden] { display: none; }
@media (max-width:600px) { .hero-preview { padding-top: 116px; } .bar { gap: 5px; padding-left: 10px; } .bar button { padding-inline: 7px; } .tab { margin-left: 6px; } }
@media(prefers-reduced-motion:reduce) { .hero-preview :global(.cs-caret), .hero-preview :global(.cs-tl) { animation: none; opacity: 1; } }
</style>
<script>
import "../scripts/codeStory.js";
</script>
