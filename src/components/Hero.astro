---
import CodeWindow from './CodeWindow.astro';
const photo = `${import.meta.env.BASE_URL}/images/fernando-garin-hero-wide.png`;
const cv = `${import.meta.env.BASE_URL}/cv/Fernando-Garin-Tejedor-CV.pdf`;
---
<section class="hero" id="inicio">
  <div class="hero-glow"></div>
  <div class="shell hero-grid">
    <div class="hero-copy">
      <CodeWindow />
      <h1>Desarrollador de Soluciones <span>&amp;</span> Microservicios .NET</h1>
      <p class="hero-lead">Desarrollo sistemas backend con .NET: microservicios, APIs y procesamiento de eventos. Trabajo con mensajería y contenedores para integrar sistemas distribuidos, y modernizo sistemas legacy sin detener la operación.</p>
      <div class="badges" aria-label="Especialidades">
        <span>+20 años de experiencia</span><span>Microservicios .NET</span><span>Arquitectura de Software</span>
      </div>
      <div class="hero-actions">
        <a class="button" href="#proyectos">Ver mis proyectos <span aria-hidden="true">→</span></a>
        <a class="button button-ghost" href={cv} download>Descargar CV <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    <div class="portrait-wrap">
      <div class="portrait-ring"></div>
      <img class="portrait" src={photo} alt="Fernando Garín Tejedor trabajando frente a sus notebooks" width="1672" height="940" fetchpriority="high" />
      <div class="portrait-label"><span class="status-dot"></span> Disponible para nuevos desafíos</div>
    </div>
  </div>
  <a class="scroll-cue" href="#sobre-mi" aria-label="Continuar a Sobre mí">Explorar <span>↓</span></a>
</section>
