---
const cdn = 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons';
const stack = [
  { name: '.NET / C#', icon: `${cdn}/dot-net/dot-net-original.svg` },
  { name: 'Angular', icon: `${cdn}/angular/angular-original.svg` },
  { name: 'TypeScript', icon: `${cdn}/typescript/typescript-original.svg` },
  { name: 'SQL Server', icon: `${cdn}/microsoftsqlserver/microsoftsqlserver-original.svg` },
  { name: 'PostgreSQL', icon: `${cdn}/postgresql/postgresql-original.svg` },
  { name: 'Oracle', icon: `${cdn}/oracle/oracle-original.svg` },
  { name: 'MongoDB', icon: `${cdn}/mongodb/mongodb-original.svg` },
  { name: 'Docker', icon: `${cdn}/docker/docker-original.svg` },
  { name: 'Azure', icon: `${cdn}/azure/azure-original.svg` },
  { name: 'Kafka', icon: `${cdn}/apachekafka/apachekafka-original.svg` },
  { name: 'RabbitMQ', icon: `${cdn}/rabbitmq/rabbitmq-original.svg` },
  { name: 'Git', icon: `${cdn}/git/git-original.svg` },
];
---
<section class="section section-tight" id="stack">
  <div class="shell">
    <p class="section-kicker">Tecnologías principales</p>
    <div class="stack-list">{stack.map((item) => <div class="stack-item"><img src={item.icon} alt="" width="42" height="42" loading="lazy" /><strong>{item.name}</strong></div>)}</div>
  </div>
</section>
