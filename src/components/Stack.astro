---
interface StackItem {
  name: string;
  icon?: string;
  svg?: string;
  mono?: string;
  white?: boolean;
}

const cdn = 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons';
const icon = (slug: string, variant = 'original') => `${cdn}/${slug}/${slug}-${variant}.svg`;
const simpleIcon = (slug: string) => `https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${slug}.svg`;

// Íconos propios en línea para conceptos que no tienen logo de marca (microservicios,
// mensajería, arquitectura) — trazo minimalista, un acento de color por ítem, pensados para
// fondo oscuro (mismo criterio que el resto del sitio: nunca un color que sólo sirva en claro).
const svgMicroservices = `<svg viewBox="0 0 24 24" fill="none" stroke="#2878ff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2.6" width="6" height="6" rx="1.5"/><rect x="2" y="15.4" width="6" height="6" rx="1.5"/><rect x="16" y="15.4" width="6" height="6" rx="1.5"/><path d="M12 8.6v3.2M10.6 15.4l1.1-2.9M13.4 15.4l-1.1-2.9"/></svg>`;
const svgQueue = `<svg viewBox="0 0 24 24" fill="none" stroke="#2bd0e7" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="1.4" y="8.6" width="5.2" height="6.8" rx="1.2"/><rect x="9.4" y="8.6" width="5.2" height="6.8" rx="1.2"/><rect x="17.4" y="4.6" width="5.2" height="6.8" rx="1.2"/><path d="M6.8 12h2.4M14.8 8.6v-1a2 2 0 0 1 2-2h.4"/></svg>`;
const svgArchitecture = `<svg viewBox="0 0 24 24" fill="none" stroke="#9873ff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3.4" width="18" height="4.4" rx="1.4"/><rect x="3" y="9.8" width="18" height="4.4" rx="1.4"/><rect x="3" y="16.2" width="18" height="4.4" rx="1.4"/></svg>`;

const categories: { title: string; items: StackItem[] }[] = [
  {
    title: 'Backend',
    items: [
      { name: '.NET / C#', icon: icon('dot-net') },
      { name: 'ASP.NET Core', icon: icon('dotnetcore') },
      { name: 'REST APIs', mono: '⇄' },
      { name: 'Java', icon: icon('java') },
    ],
  },
  {
    title: 'Frontend',
    items: [
      { name: 'Angular', icon: icon('angular') },
      { name: 'TypeScript', icon: icon('typescript') },
      { name: 'HTML / CSS', icon: icon('html5') },
    ],
  },
  {
    title: 'Arquitectura & Patrones',
    items: [
      { name: 'Microservicios', svg: svgMicroservices },
      { name: 'Mensajería / Colas', svg: svgQueue },
      { name: 'Arquitectura de Software', svg: svgArchitecture },
    ],
  },
  {
    title: 'Datos',
    items: [
      { name: 'PostgreSQL', icon: icon('postgresql') },
      { name: 'SQL Server', icon: icon('microsoftsqlserver') },
      { name: 'Oracle', icon: icon('oracle') },
      { name: 'MongoDB', icon: icon('mongodb') },
      { name: 'MySQL', icon: icon('mysql') },
    ],
  },
  {
    title: 'Infraestructura & DevOps',
    items: [
      { name: 'Docker', icon: icon('docker') },
      { name: 'Azure', icon: icon('azure') },
      { name: 'Kafka', icon: icon('apachekafka'), white: true },
      { name: 'RabbitMQ', icon: icon('rabbitmq') },
    ],
  },
  {
    title: 'Herramientas',
    items: [
      { name: 'Git / GitHub', icon: icon('git') },
      { name: 'VS Code', icon: icon('vscode') },
      { name: 'Claude Code', icon: simpleIcon('claude'), white: true },
      { name: 'Codex', icon: simpleIcon('openai'), white: true },
    ],
  },
];

const others = ['VB6', 'ASP', 'Ajax', 'Windows Forms', 'HMAC', 'JWT', 'Scrum'];
---
<section class="section section-tight" id="stack">
  <div class="shell">
    <p class="section-kicker">Tecnologías principales</p>
    <div class="stack-groups">
      {categories.map((cat) => (
        <div class="stack-group">
          <h3>{cat.title}</h3>
          <div class="stack-group-items">
            {cat.items.map((item) => (
              <div class="stack-chip">
                {item.icon ? (
                  <img src={item.icon} alt="" width="24" height="24" loading="lazy" class={item.white ? 'icon-white' : ''} />
                ) : item.svg ? (
                  <span class="stack-svg" set:html={item.svg} />
                ) : (
                  <span class="stack-mono">{item.mono}</span>
                )}
                <span>{item.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="stack-others">
      <span class="stack-others-label">Otras tecnologías</span>
      <div class="stack-others-list">{others.map((tech) => <span>{tech}</span>)}</div>
    </div>
  </div>
</section>
