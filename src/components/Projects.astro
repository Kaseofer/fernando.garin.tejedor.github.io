---
const teroPhoto = `${import.meta.env.BASE_URL}/images/tero-gestion-de-turnos.png`;
const consultorioPhoto = `${import.meta.env.BASE_URL}/images/consultorio-one-consulta.png`;
const projects = [
  {
    number: '01',
    title: 'Tero — Gestión de turnos multi-rubro',
    subtitle: 'Proyecto personal',
    text: 'Plataforma SaaS multi-tenant de gestión de turnos multi-rubro: cada organización (salud, estética, bienestar, servicios profesionales) con su agenda, sus profesionales y sus clientes. Reserva online, portal de autogestión para el cliente (con familiares a cargo), dashboard operativo del profesional con disponibilidad en tiempo real, motivos de turno configurables, notas y recordatorios, y notificaciones por email y WhatsApp. Diseñada y construida de punta a punta dirigiendo agentes de IA (Claude Code, Codex).',
    tags: ['.NET 8', 'Angular 22', 'PostgreSQL', 'Docker', 'RabbitMQ', 'Microservicios'],
    accent: 'cyan',
    photo: teroPhoto,
    alt: 'Tero: gestión de turnos multi-rubro, con turnos confirmados de distintas organizaciones (datos de ejemplo)',
  },
  {
    number: '02',
    title: 'Consultorio One',
    subtitle: 'Proyecto propio · 1998 – actualidad',
    text: 'Gestión para consultorios. Nació en 1998 como SIC, en Visual Basic 6 y Access, y fue mi tesis final de Ingeniería en Informática (calificada con 10). Hoy lo estoy migrando a una plataforma multi-tenant con microservicios, con versión web y mobile.',
    tags: ['.NET 10', 'Angular', 'RabbitMQ', 'PostgreSQL', 'MinIO'],
    accent: 'violet',
    photo: consultorioPhoto,
    alt: 'Mockup de la consulta en curso en Consultorio One (datos de ejemplo)',
  },
];
---
<section class="section" id="proyectos">
  <div class="shell">
    <div class="section-heading"><div><p class="section-kicker">Proyectos destacados</p><h2>Soluciones que convierten complejidad en impacto.</h2></div><a href="#contacto">Hablemos de tu proyecto →</a></div>
    <div class="projects-grid">{projects.map((project) => (
      <article class={`project-card ${project.accent}`}>
        <div class="project-top"><span>{project.number}</span><span>{project.subtitle}</span></div>
        <div class="project-visual project-visual-photo"><img src={project.photo} alt={project.alt} width="600" height="180" loading="lazy" /></div>
        <h3>{project.title}</h3>
        <p>{project.text}</p>
        <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
      </article>
    ))}</div>
  </div>
</section>

<style>
  /* dos proyectos: mantener el ancho de tarjeta, no estirar a 3 columnas */
  .projects-grid { grid-template-columns: repeat(2, minmax(0, 380px)); }
  @media (max-width: 820px) { .projects-grid { grid-template-columns: 1fr; } }
</style>
