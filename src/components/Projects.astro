---
const teroLogo = `${import.meta.env.BASE_URL}/images/tero-logo.png`;
const iotGatewayPhoto = `${import.meta.env.BASE_URL}/images/iot-gateway.png`;
const gobiernoDigitalPhoto = `${import.meta.env.BASE_URL}/images/gobierno-digital.png`;
const projects = [
  {
    number: '01',
    title: 'Tero',
    subtitle: 'Proyecto personal',
    text: 'Plataforma SaaS multi-tenant de agenda digital para profesionales y organizaciones de salud/servicios. Reserva online, portal de autogestión para el cliente (con familiares a cargo), dashboard operativo del profesional con disponibilidad en tiempo real, motivos de turno configurables, notas y recordatorios, y notificaciones por email y WhatsApp. Diseñada y construida de punta a punta dirigiendo agentes de IA (Claude Code, Codex).',
    tags: ['.NET 8', 'Angular 22', 'PostgreSQL', 'Docker', 'RabbitMQ', 'Microservicios'],
    accent: 'cyan',
    logo: teroLogo,
  },
  { number: '02', title: 'IoT Gateway', subtitle: 'Sistemas distribuidos', text: 'Gateway de recepción de eventos IoT con autenticación HMAC, procesamiento y mensajería a escala.', tags: ['.NET', 'Kafka', 'HMAC', 'Docker'], accent: 'blue', photo: iotGatewayPhoto },
  { number: '03', title: 'Gobierno Digital', subtitle: 'Modernización legacy', text: 'Modernización de sistemas legacy y construcción de plataformas web modernas para el sector público.', tags: ['.NET', 'Angular', 'Oracle', 'PostgreSQL'], accent: 'violet', photo: gobiernoDigitalPhoto },
  { number: '04', title: 'SIC — Sistema Integral de Cardiología', subtitle: 'Proyecto propio · 1998–2000', text: 'Sistema de gestión de historias clínicas y estudios cardiológicos para un centro médico: carga y seguimiento de historias clínicas, gestión y turnos de estudios, listados e informes, y emisión de carnets de salud.', tags: ['Visual Basic 6', 'SQL Server'], accent: 'blue' },
];
---
<section class="section" id="proyectos">
  <div class="shell">
    <div class="section-heading"><div><p class="section-kicker">Proyectos destacados</p><h2>Soluciones que convierten complejidad en impacto.</h2></div><a href="#contacto">Hablemos de tu proyecto →</a></div>
    <div class="projects-grid">{projects.map((project) => (
      <article class={`project-card ${project.accent}`}>
        <div class="project-top"><span>{project.number}</span><span>{project.subtitle}</span></div>
        {project.logo ? (
          <div class="project-visual project-visual-logo"><img src={project.logo} alt={`Logo de ${project.title}`} width="72" height="72" loading="lazy" /></div>
        ) : project.photo ? (
          <div class="project-visual project-visual-photo"><img src={project.photo} alt="" width="600" height="180" loading="lazy" /></div>
        ) : (
          <div class="project-visual"><span></span><span></span><span></span><i></i></div>
        )}
        <h3>{project.title}</h3>
        <p>{project.text}</p>
        <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
      </article>
    ))}</div>
  </div>
</section>
