---
const roles = [
  { date: '2025 — Actualidad', company: 'Urbetrack', role: 'Backend Developer Sr. — Plataforma de geolocalización de flotas', text: 'Empresa de geomática y telemetría, líder en higiene urbana, con clientes en Argentina, México, Colombia, Chile y España. Desarrollo la plataforma de gestión automatizada por GPS del servicio de limpieza: geolocalización de flotas en tiempo real, trazabilidad del servicio (recorridos, frecuencias, incidencias y certificación de tareas), ingesta de sensores IoT en los camiones y dashboards de control para municipios y operadores.', tags: ['.NET', 'Microservicios', 'Event-driven', 'Kafka', 'Docker', 'IoT / GPS', 'PostgreSQL', 'REST APIs'] },
  { date: '2011 — 2025', company: 'Inspección General de Justicia', role: 'Desarrollador .NET Backend Sr. / Arquitecto de Sistemas', text: '13 años como referente técnico .NET del organismo: diseño de arquitectura y desarrollo backend de extremo a extremo, liderando la modernización de aplicaciones legacy hacia plataformas web y SPA con Angular, con APIs y servicios como base de la integración. Fuerte trabajo sobre SQL Server, Oracle y PostgreSQL. Principales sistemas: balances y asambleas digitales, seguimiento de trámites y declaraciones juradas, gestión documental y digitalización de trámites.', tags: ['C#', '.NET 6 → 2.0', 'ASP.NET Core / MVC', 'Angular 14', 'TypeScript', 'REST APIs', 'SQL Server', 'Oracle', 'PostgreSQL', 'MongoDB'] },
  { date: '2005 — 2011', company: 'GLD Consultores SRL', role: 'Project Leader / Arquitecto de Sistemas .NET', text: 'Como arquitecto .NET y líder técnico entregué soluciones a medida para tres clientes. Para la Asociación Argentina de Tenis diseñé y construí el sistema integral de torneos: afiliación de socios, inscripción y fixture por categoría, carga de resultados y actualización automática de los rankings nacionales. En el Ministerio de Trabajo desarrollé módulos del Sistema PNRT (Programa Nacional de Regularización del Trabajo) y los procesos y rutinas SQL de alto volumen para la liquidación de Planes Sociales (Jefes de Hogar, AUH).', tags: ['.NET 2.0', 'C#', 'Ajax', 'ASP', 'SQL Server', 'T-SQL'] },
  { date: '2003 — 2004', company: 'AWK Consultores — Correo Argentino', role: 'Analista Programador — Sistema de Seguimiento de Envíos', text: 'Desarrollo e implantación del tracking de piezas postales y encomiendas de extremo a extremo: captura de eventos en sucursales y centros de distribución (admisión, despacho, arribo, distribución y entrega), consulta de trazabilidad para clientes y tableros operativos para la gestión de la red logística.', tags: ['Java', 'Visual Basic 6', 'SQL Server'] },
];
---
<section class="section" id="experiencia">
  <div class="shell">
    <p class="section-kicker">Experiencia destacada</p>
    <div class="experience-grid">
      <div class="timeline">
        {roles.map((item) => <article class="role"><div class="role-date">{item.date}</div><div class="role-body"><h3>{item.company}</h3>{item.role && <strong>{item.role}</strong>}<p>{item.text}</p><div class="tags">{item.tags.map((tag) => <span>{tag}</span>)}</div></div></article>)}
      </div>
      <aside class="stats" aria-label="Cifras profesionales"><div><strong>+20</strong><span>Años de experiencia</span></div><div><strong>30+</strong><span>Proyectos exitosos</span></div><div><strong>10+</strong><span>Tecnologías dominadas</span></div></aside>
    </div>
  </div>
</section>
