---
import FgtMark from './FgtMark.astro';
const cv = `${import.meta.env.BASE_URL}/cv/Fernando-Garin-Tejedor-CV.pdf`;
---
<header class="site-header" data-header>
  <div class="shell nav-wrap">
    <a class="brand brand-logo" href="#inicio" aria-label="Ir al inicio"><FgtMark height={76} animate /></a>
    <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-toggle>
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" aria-label="Navegación principal" data-menu>
      <a href="#inicio">Inicio</a><a href="#sobre-mi">Sobre mí</a><a href="#ia">IA</a><a href="#experiencia">Experiencia</a>
      <a href="#formacion">Formación</a><a href="#proyectos">Proyectos</a><a href="#stack">Stack</a><a href="#contacto">Contacto</a>
      <a class="nav-social" href="https://github.com/Kaseofer" target="_blank" rel="noreferrer" aria-label="GitHub">GH</a>
      <a class="nav-social" href="https://www.linkedin.com/in/fernandogarintejedor/" target="_blank" rel="noreferrer" aria-label="LinkedIn">in</a>
      <a class="button button-small button-ghost" href={cv} download>Descargar CV <span aria-hidden="true">↓</span></a>
    </nav>
  </div>
  <div class="nav-backdrop" data-menu-backdrop></div>
</header>

<style>
  .brand-logo { flex-shrink: 0; width: min(380px, calc(100% - 52px)); }
  .nav { gap: 14px; font-size: .75rem; }
  @media (max-width: 1100px) {
    .menu-toggle { display: block; position: relative; z-index: 61; }
    .nav {
      visibility: hidden; opacity: 0; pointer-events: none;
      position: absolute; top: 82px; right: 20px;
      width: min(72vw, 280px); padding: 18px;
      flex-direction: column; align-items: stretch; gap: 16px;
      background: #0b1928; border: 1px solid var(--line);
      border-radius: 14px; z-index: 61;
    }
    .nav.is-open { visibility: visible; opacity: 1; pointer-events: auto; }
    .nav-backdrop.is-open { display: block; position: fixed; inset: 0; background: #03080f9e; z-index: 59; }
  }
</style>
