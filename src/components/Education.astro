---
const study = {
  period: '1998 — 2002',
  title: 'Ingeniero en Informática',
  place: 'Universidad Nacional de La Matanza',
};

const courses = [
  { year: '2002 — 2005', name: '.NET Framework 1.0 / 1.1, C#, WinForms, ASP.NET Web Forms y ADO.NET', by: 'Formación complementaria' },
  { year: '2006 — 2009', name: '.NET Framework 2.0 / 3.5 y desarrollo de aplicaciones empresariales', by: 'Formación complementaria' },
  { year: '2010 — 2013', name: 'SQL Server avanzado, T-SQL y optimización de consultas', by: 'Curso de actualización técnica · Udemy' },
  { year: '2014 — 2016', name: 'ASP.NET MVC, Entity Framework y aplicaciones web con C#', by: 'Curso de actualización técnica · Udemy' },
  { year: '2017 — 2020', name: 'PostgreSQL, APIs REST y modernización de aplicaciones .NET', by: 'Curso de actualización técnica · Udemy' },
  { year: '2021 — 2025', name: 'Microservicios .NET, Docker, Kafka y arquitectura orientada a eventos', by: 'Actualización técnica continua' },
];
---
<section class="section section-tight" id="formacion">
  <div class="shell">
    <p class="section-kicker">Formación y actualización técnica</p>
    <div class="timeline">
      <article class="role">
        <div class="role-date">{study.period}</div>
        <div class="role-body">
          <h3>{study.title}</h3>
          <strong>{study.place}</strong>
        </div>
      </article>
      {courses.map((course) => (
        <article class="role">
          <div class="role-date">{course.year}</div>
          <div class="role-body"><h3>{course.name}</h3><strong>{course.by}</strong></div>
        </article>
      ))}
    </div>
  </div>
</section>
