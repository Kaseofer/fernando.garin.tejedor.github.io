---
const study = {
  period: '1998 — 2002',
  title: 'Ingeniero en Informática',
  place: 'Universidad Nacional de La Matanza',
};

const courses = [
  { year: '2024', name: 'Docker & Kubernetes: The Complete Guide', by: 'Stephen Grider · Udemy' },
  { year: '2022', name: 'Apache Kafka Series – Learn Apache Kafka for Beginners', by: 'Stéphane Maarek · Udemy' },
  { year: '2021', name: '.NET Microservices: CQRS & Event Sourcing with Kafka', by: 'Mehmet Özkaya · Udemy' },
];
---
<section class="section section-tight" id="formacion">
  <div class="shell">
    <p class="section-kicker">Formación</p>
    <div class="timeline">
      <article class="role">
        <div class="role-date">{study.period}</div>
        <div class="role-body">
          <h3>{study.title}</h3>
          <strong>{study.place}</strong>
        </div>
      </article>
      {courses.map((course) => (
        <article class="role">
          <div class="role-date">{course.year}</div>
          <div class="role-body"><h3>{course.name}</h3><strong>{course.by}</strong></div>
        </article>
      ))}
    </div>
  </div>
</section>
