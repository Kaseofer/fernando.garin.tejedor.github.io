---
// Cartel original, encuadrado y reducido al espacio de la marca.
interface Props {
  height?: number;
}
const { height = 44 } = Astro.props;
const logo = `${import.meta.env.BASE_URL}/images/logo_nombre_profolio.png`;
---
<span class="fgt-mark" style={`height:${height}px;width:${height * 2.8}px`}>
  <img src={logo} alt="Ing. Fernando Garín Tejedor" width="1536" height="1024" />
</span>

<style>
  .fgt-mark {
    position: relative;
    display: block;
    flex-shrink: 0;
    overflow: hidden;
  }

  .fgt-mark img {
    position: absolute;
    width: 145%;
    max-width: none;
    height: auto;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -48%);
    filter: saturate(.65) brightness(.82) contrast(1.08);
  }
</style>
