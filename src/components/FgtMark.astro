---
// Monograma propio (no AI-generado): "FG" en blanco + "T" en azul de marca, con una barra
// azul debajo — mismo lenguaje visual que el resto del sitio (blanco/azul, sin caja ni
// efectos 3D), pensado para leerse bien tanto en el header como en el footer.
interface Props {
  height?: number;
}
const { height = 30 } = Astro.props;
---
<svg class="fgt-mark" viewBox="0 0 92 36" style={`height:${height}px`} role="img" aria-label="FGT">
  <text x="0" y="25" font-family="Manrope, sans-serif" font-weight="800" font-size="25" letter-spacing="0.3" fill="var(--text, #f6f8fb)">FG<tspan fill="var(--blue, #2878ff)">T</tspan></text>
  <rect x="1" y="31" width="52" height="2.6" rx="1.3" fill="var(--blue, #2878ff)" />
</svg>
