---
interface Props {
  height?: number;
  animate?: boolean;
}
const { height = 44, animate = false } = Astro.props;
const tokens = [
  { text: 'var', color: '#569cd6' },
  { text: ' ingeniero ', color: '#9cdcfe' },
  { text: '= ', color: '#d4d4d4' },
  { text: 'new', color: '#569cd6' },
  { text: ' ', color: '#d4d4d4' },
  { text: 'FernandoGarinTejedor', color: '#4ec9b0' },
  { text: '();', color: '#d4d4d4' },
];
---
<svg class="fgt-mark" viewBox="0 0 900 120" width={height * 7.5} height={height}
  role="img" aria-label="var ingeniero = new FernandoGarinTejedor();"
  data-terminal data-animate={String(animate)}>
  <g aria-hidden="true" data-code-line>
    <text x="27" y="75" xml:space="preserve" font-family="Arial Narrow, Arial, sans-serif" font-stretch="condensed" font-size="40.5" font-weight="400" letter-spacing="0" data-code-text>{tokens.map(token => <tspan fill={token.color} data-token={token.text}>{token.text}</tspan>)}</text>
    <rect class="terminal-cursor" data-cursor x="847.5" y="39" width="12" height="43.5" fill="#d4d4d4" />
  </g>
</svg>

<style>
  .fgt-mark { display: block; flex-shrink: 0; max-width: 100%; }
  .terminal-cursor { animation: cursor-blink 1s steps(1) infinite; }
  .fgt-mark[data-typing] .terminal-cursor { animation: none; }
  @keyframes cursor-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .terminal-cursor { animation: none; } }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<SVGSVGElement>('[data-terminal]').forEach((terminal) => {
    const text = terminal.querySelector<SVGTextElement>('[data-code-text]')!;
    const line = terminal.querySelector<SVGGElement>('[data-code-line]')!;
    const cursor = terminal.querySelector<SVGRectElement>('[data-cursor]')!;
    const tokens = Array.from(terminal.querySelectorAll<SVGTSpanElement>('[data-token]'));
    const total = tokens.reduce((sum, token) => sum + token.dataset.token!.length, 0);
    // Fit the complete statement once; partial typing never changes its scale.
    const scale = Math.min(1, 840 / (text.getComputedTextLength() + 21));
    line.setAttribute('transform', `translate(${27 * (1 - scale)} 0) scale(${scale} 1)`);
    let timer: ReturnType<typeof setTimeout>;
    let count = total;
    const render = () => {
      let remaining = count;
      tokens.forEach((token) => {
        const value = token.dataset.token!;
        token.textContent = value.slice(0, Math.max(0, remaining));
        remaining -= value.length;
      });
      cursor.setAttribute('x', String(33 + text.getComputedTextLength()));
      terminal.toggleAttribute('data-typing', count < total);
    };
    const tick = () => {
      if (!terminal.isConnected) return;
      count = count >= total ? 0 : count + 1;
      render();
      timer = setTimeout(tick, count === total ? 7000 : 70);
    };
    const start = () => {
      clearTimeout(timer);
      count = total;
      render();
      if (terminal.dataset.animate === 'true' && !reducedMotion.matches) {
        timer = setTimeout(tick, 2500);
      }
    };
    reducedMotion.addEventListener('change', start);
    start();
  });
</script>
