---
// Cartel original, encuadrado y reducido al espacio de la marca.
interface Props {
  height?: number;
}
const { height = 44 } = Astro.props;
const logo = `${import.meta.env.BASE_URL}/images/logo-nombre-terminal.png`;
---
<span class="fgt-mark" style={`height:${height}px;width:${height * 3}px`}>
  <img src={logo} alt="Ing. Fernando Garín Tejedor" width="2172" height="724" />
</span>

<style>
  .fgt-mark {
    position: relative;
    display: block;
    flex-shrink: 0;
    overflow: hidden;
  }

  .fgt-mark img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
