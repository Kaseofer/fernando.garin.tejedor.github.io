---
// Firma monocromática inspirada en una terminal, sin brillo ni marco.
interface Props {
  height?: number;
}
const { height = 44 } = Astro.props;
---
<svg class="fgt-mark" viewBox="0 0 160 32" width={height * 5} height={height} role="img" aria-label="Ing. Fernando Garín Tejedor" fill="#d6e3dd" style="flex-shrink:0;letter-spacing:0">
  <path d="m2 5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.5" />
  <g font-family="'Cascadia Code', Consolas, 'Liberation Mono', monospace" font-size="12" font-weight="500">
    <text x="17" y="12">Ing. Fernando</text>
    <text x="17" y="28">Garín Tejedor</text>
  </g>
  <rect x="115" y="26" width="7" height="2" />
</svg>
