---
const metrics = [
  { value: '20+', label: 'años en desarrollo de software' },
  { value: '~15', label: 'años como referente .NET en el sector público' },
  { value: '2.0 → 10', label: 'versiones de .NET usadas en producción' },
  { value: '5', label: 'países con telemetría GPS en tiempo real' },
];
---
<section class="metrics-band" aria-label="En números">
  <div class="shell">
    <dl class="metrics">
      {metrics.map((m) => (
        <div class="metric">
          <dt set:html={m.value.replace('→', '<span class="arrow">→</span>')} />
          <dd>{m.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .metrics-band { border-bottom: 1px solid var(--line); }
  .metrics { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding-block: 40px; }
  .metric { display: flex; flex-direction: column; gap: 6px; padding-inline: 24px; border-left: 1px solid var(--line); }
  .metric:first-child { padding-left: 0; border-left: 0; }
  dt { font-size: 2.6rem; font-weight: 800; line-height: 1; letter-spacing: -.03em; color: #fff; }
  dt :global(.arrow) { color: var(--blue); }
  dd { margin: 0; font-size: .85rem; color: var(--muted); }
  @media (max-width: 900px) {
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding-block: 28px; }
    .metric, .metric:first-child { padding: 16px; border: 1px solid var(--line); border-radius: 12px; }
    dt { font-size: 1.9rem; }
    dd { font-size: .78rem; }
  }
</style>
